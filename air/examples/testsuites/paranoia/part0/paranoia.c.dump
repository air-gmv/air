    <tok fileIndex="0" linenr="2229" column="5" str="static"/>
    <tok fileIndex="0" linenr="2229" column="12" str="char"/>
    <tok fileIndex="0" linenr="2229" column="17" str="*"/>
    <tok fileIndex="0" linenr="2229" column="18" str="head"/>
    <tok fileIndex="0" linenr="2229" column="22" str="["/>
