    <tok fileIndex="0" linenr="2211" column="5" str="{"/>
    <tok fileIndex="0" linenr="2212" column="9" str="&quot;Lest this program stop prematurely, i.e. before displaying\n&quot;"/>
    <tok fileIndex="0" linenr="2212" column="71" str=","/>
    <tok fileIndex="0" linenr="2213" column="9" str="&quot;    `END OF TEST&apos;,\n&quot;"/>
    <tok fileIndex="0" linenr="2213" column="31" str=","/>
    <tok fileIndex="0" linenr="2214" column="9" str="&quot;try to persuade the computer NOT to terminate execution when an&quot;"/>
    <tok fileIndex="0" linenr="2214" column="74" str=","/>
    <tok fileIndex="0" linenr="2215" column="9" str="&quot;error like Over/Underflow or Division by Zero occurs, but rather&quot;"/>
    <tok fileIndex="0" linenr="2215" column="75" str=","/>
    <tok fileIndex="0" linenr="2216" column="9" str="&quot;to persevere with a surrogate value after, perhaps, displaying some&quot;"/>
    <tok fileIndex="0" linenr="2216" column="78" str=","/>
    <tok fileIndex="0" linenr="2217" column="9" str="&quot;warning.  If persuasion avails naught, don&apos;t despair but run this&quot;"/>
    <tok fileIndex="0" linenr="2217" column="76" str=","/>
    <tok fileIndex="0" linenr="2218" column="9" str="&quot;program anyway to see how many milestones it passes, and then&quot;"/>
    <tok fileIndex="0" linenr="2218" column="72" str=","/>
    <tok fileIndex="0" linenr="2219" column="9" str="&quot;amend it to make further progress.\n&quot;"/>
    <tok fileIndex="0" linenr="2219" column="47" str=","/>
    <tok fileIndex="0" linenr="2220" column="9" str="&quot;Answer questions with Y, y, N or n (unless otherwise indicated).\n&quot;"/>
    <tok fileIndex="0" linenr="2220" column="77" str=","/>
    <tok fileIndex="0" linenr="2221" column="9" str="0"/>
    <tok fileIndex="0" linenr="2221" column="10" str="}"/>
    <tok fileIndex="0" linenr="2221" column="11" str=";"/>
