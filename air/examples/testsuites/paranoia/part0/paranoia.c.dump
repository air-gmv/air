    <tok fileIndex="0" linenr="2230" column="5" str="{"/>
    <tok fileIndex="0" linenr="2231" column="9" str="&quot;Users are invited to help debug and augment this program so it will&quot;"/>
    <tok fileIndex="0" linenr="2231" column="78" str=","/>
    <tok fileIndex="0" linenr="2232" column="9" str="&quot;cope with unanticipated and newly uncovered arithmetic pathologies.\n&quot;"/>
    <tok fileIndex="0" linenr="2232" column="80" str=","/>
    <tok fileIndex="0" linenr="2233" column="9" str="&quot;Please send suggestions and interesting results to&quot;"/>
    <tok fileIndex="0" linenr="2233" column="61" str=","/>
    <tok fileIndex="0" linenr="2234" column="9" str="&quot;\tRichard Karpinski&quot;"/>
    <tok fileIndex="0" linenr="2234" column="30" str=","/>
    <tok fileIndex="0" linenr="2235" column="9" str="&quot;\tComputer Center U-76&quot;"/>
    <tok fileIndex="0" linenr="2235" column="33" str=","/>
    <tok fileIndex="0" linenr="2236" column="9" str="&quot;\tUniversity of California&quot;"/>
    <tok fileIndex="0" linenr="2236" column="37" str=","/>
    <tok fileIndex="0" linenr="2237" column="9" str="&quot;\tSan Francisco, CA 94143-0704, USA\n&quot;"/>
    <tok fileIndex="0" linenr="2237" column="48" str=","/>
    <tok fileIndex="0" linenr="2238" column="9" str="&quot;In doing so, please include the following information:&quot;"/>
    <tok fileIndex="0" linenr="2238" column="65" str=","/>
    <tok fileIndex="0" linenr="2239" column="1" str="#"/>
    <tok fileIndex="0" linenr="2239" column="2" str="ifdef"/>
    <tok fileIndex="0" linenr="2239" column="8" str="SINGLE_PRECISION"/>
    <tok fileIndex="0" linenr="2240" column="9" str="&quot;\tPrecision:\tsingle;&quot;"/>
    <tok fileIndex="0" linenr="2240" column="32" str=","/>
    <tok fileIndex="0" linenr="2241" column="1" str="#"/>
    <tok fileIndex="0" linenr="2241" column="2" str="else"/>
    <tok fileIndex="0" linenr="2241" column="7" str="/* !SINGLE_PRECISION */"/>
    <tok fileIndex="0" linenr="2242" column="9" str="&quot;\tPrecision:\tdouble;&quot;"/>
    <tok fileIndex="0" linenr="2242" column="32" str=","/>
    <tok fileIndex="0" linenr="2243" column="1" str="#"/>
    <tok fileIndex="0" linenr="2243" column="2" str="endif"/>
    <tok fileIndex="0" linenr="2243" column="8" str="/* SINGLE_PRECISION */"/>
    <tok fileIndex="0" linenr="2244" column="9" str="&quot;\tVersion:\t10 February 1989;&quot;"/>
    <tok fileIndex="0" linenr="2244" column="40" str=","/>
    <tok fileIndex="0" linenr="2245" column="9" str="&quot;\tComputer:\n&quot;"/>
    <tok fileIndex="0" linenr="2245" column="24" str=","/>
    <tok fileIndex="0" linenr="2246" column="9" str="&quot;\tCompiler:\n&quot;"/>
    <tok fileIndex="0" linenr="2246" column="24" str=","/>
    <tok fileIndex="0" linenr="2247" column="9" str="&quot;\tOptimization level:\n&quot;"/>
    <tok fileIndex="0" linenr="2247" column="34" str=","/>
    <tok fileIndex="0" linenr="2248" column="9" str="&quot;\tOther relevant compiler options:&quot;"/>
    <tok fileIndex="0" linenr="2248" column="45" str=","/>
    <tok fileIndex="0" linenr="2249" column="9" str="0"/>
    <tok fileIndex="0" linenr="2249" column="10" str="}"/>
    <tok fileIndex="0" linenr="2249" column="11" str=";"/>
    <tok fileIndex="0" linenr="2251" column="5" str="msglist"/>
    <tok fileIndex="0" linenr="2251" column="13" str="("/>
    <tok fileIndex="0" linenr="2251" column="14" str="head"/>
    <tok fileIndex="0" linenr="2251" column="18" str=")"/>
    <tok fileIndex="0" linenr="2251" column="19" str=";"/>
    <tok fileIndex="0" linenr="2252" column="1" str="}"/>
    <tok fileIndex="0" linenr="2254" column="1" str="void"/>
    <tok fileIndex="0" linenr="2255" column="1" str="Characteristics"/>
    <tok fileIndex="0" linenr="2255" column="17" str="("/>
    <tok fileIndex="0" linenr="2255" column="18" str=")"/>
    <tok fileIndex="0" linenr="2256" column="1" str="{"/>
    <tok fileIndex="0" linenr="2257" column="5" str="static"/>
    <tok fileIndex="0" linenr="2257" column="12" str="char"/>
    <tok fileIndex="0" linenr="2257" column="17" str="*"/>
    <tok fileIndex="0" linenr="2257" column="18" str="chars"/>
    <tok fileIndex="0" linenr="2257" column="23" str="["/>
    <tok fileIndex="0" linenr="2257" column="24" str="]"/>
    <tok fileIndex="0" linenr="2257" column="26" str="="/>
    <tok fileIndex="0" linenr="2258" column="5" str="{"/>
    <tok fileIndex="0" linenr="2259" column="9" str="&quot;Running this program should reveal these characteristics:&quot;"/>
    <tok fileIndex="0" linenr="2259" column="68" str=","/>
    <tok fileIndex="0" linenr="2260" column="9" str="&quot;     Radix = 1, 2, 4, 8, 10, 16, 100, 256 ...&quot;"/>
    <tok fileIndex="0" linenr="2260" column="56" str=","/>
    <tok fileIndex="0" linenr="2261" column="9" str="&quot;     Precision = number of significant digits carried.&quot;"/>
    <tok fileIndex="0" linenr="2261" column="65" str=","/>
    <tok fileIndex="0" linenr="2262" column="9" str="&quot;     U2 = Radix/Radix^Precision = One Ulp&quot;"/>
    <tok fileIndex="0" linenr="2262" column="52" str=","/>
    <tok fileIndex="0" linenr="2263" column="9" str="&quot;\t(OneUlpnit in the Last Place) of 1.000xxx .&quot;"/>
    <tok fileIndex="0" linenr="2263" column="56" str=","/>
    <tok fileIndex="0" linenr="2264" column="9" str="&quot;     U1 = 1/Radix^Precision = One Ulp of numbers a little less than 1.0 .&quot;"/>
    <tok fileIndex="0" linenr="2264" column="84" str=","/>
    <tok fileIndex="0" linenr="2265" column="9" str="&quot;     Adequacy of guard digits for Mult., Div. and Subt.&quot;"/>
    <tok fileIndex="0" linenr="2265" column="66" str=","/>
    <tok fileIndex="0" linenr="2266" column="9" str="&quot;     Whether arithmetic is chopped, correctly rounded, or something else&quot;"/>
    <tok fileIndex="0" linenr="2266" column="83" str=","/>
    <tok fileIndex="0" linenr="2267" column="9" str="&quot;\tfor Mult., Div., Add/Subt. and Sqrt.&quot;"/>
    <tok fileIndex="0" linenr="2267" column="49" str=","/>
    <tok fileIndex="0" linenr="2268" column="9" str="&quot;     Whether a Sticky Bit used correctly for rounding.&quot;"/>
    <tok fileIndex="0" linenr="2268" column="65" str=","/>
    <tok fileIndex="0" linenr="2269" column="9" str="&quot;     UnderflowThreshold = an underflow threshold.&quot;"/>
    <tok fileIndex="0" linenr="2269" column="60" str=","/>
    <tok fileIndex="0" linenr="2270" column="9" str="&quot;     E0 and PseudoZero tell whether underflow is abrupt, gradual, or fuzzy.&quot;"/>
    <tok fileIndex="0" linenr="2270" column="86" str=","/>
    <tok fileIndex="0" linenr="2271" column="9" str="&quot;     V = an overflow threshold, roughly.&quot;"/>
    <tok fileIndex="0" linenr="2271" column="51" str=","/>
    <tok fileIndex="0" linenr="2272" column="9" str="&quot;     V0  tells, roughly, whether  Infinity  is represented.&quot;"/>
    <tok fileIndex="0" linenr="2272" column="70" str=","/>
    <tok fileIndex="0" linenr="2273" column="9" str="&quot;     Comparisions are checked for consistency with subtraction&quot;"/>
    <tok fileIndex="0" linenr="2273" column="73" str=","/>
    <tok fileIndex="0" linenr="2274" column="9" str="&quot;\tand for contamination with pseudo-zeros.&quot;"/>
    <tok fileIndex="0" linenr="2274" column="53" str=","/>
    <tok fileIndex="0" linenr="2275" column="9" str="&quot;     Sqrt is tested.  Y^X is not tested.&quot;"/>
    <tok fileIndex="0" linenr="2275" column="51" str=","/>
    <tok fileIndex="0" linenr="2276" column="9" str="&quot;     Extra-precise subexpressions are revealed but NOT YET tested.&quot;"/>
    <tok fileIndex="0" linenr="2276" column="77" str=","/>
    <tok fileIndex="0" linenr="2277" column="9" str="&quot;     Decimal-Binary conversion is NOT YET tested for accuracy.&quot;"/>
    <tok fileIndex="0" linenr="2277" column="73" str=","/>
    <tok fileIndex="0" linenr="2278" column="9" str="0"/>
    <tok fileIndex="0" linenr="2278" column="10" str="}"/>
    <tok fileIndex="0" linenr="2278" column="11" str=";"/>
    <tok fileIndex="0" linenr="2280" column="5" str="msglist"/>
    <tok fileIndex="0" linenr="2280" column="13" str="("/>
    <tok fileIndex="0" linenr="2280" column="14" str="chars"/>
    <tok fileIndex="0" linenr="2280" column="19" str=")"/>
    <tok fileIndex="0" linenr="2280" column="20" str=";"/>
    <tok fileIndex="0" linenr="2281" column="1" str="}"/>
    <tok fileIndex="0" linenr="2283" column="1" str="void"/>
    <tok fileIndex="0" linenr="2284" column="1" str="History"/>
    <tok fileIndex="0" linenr="2284" column="9" str="("/>
    <tok fileIndex="0" linenr="2284" column="10" str=")"/>
    <tok fileIndex="0" linenr="2285" column="1" str="{"/>
    <tok fileIndex="0" linenr="2285" column="33" str="/* History */"/>
    <tok fileIndex="0" linenr="2286" column="5" str="/* Converted from Brian Wichmann&apos;s Pascal version to C by Thos Sumner,x        with further massaging by David M. Gay. */"/>
    <tok fileIndex="0" linenr="2289" column="5" str="static"/>
    <tok fileIndex="0" linenr="2289" column="12" str="char"/>
    <tok fileIndex="0" linenr="2289" column="17" str="*"/>
    <tok fileIndex="0" linenr="2289" column="18" str="hist"/>
    <tok fileIndex="0" linenr="2289" column="22" str="["/>
    <tok fileIndex="0" linenr="2289" column="23" str="]"/>
    <tok fileIndex="0" linenr="2289" column="25" str="="/>
    <tok fileIndex="0" linenr="2290" column="5" str="{"/>
    <tok fileIndex="0" linenr="2291" column="9" str="&quot;The program attempts to discriminate among&quot;"/>
    <tok fileIndex="0" linenr="2291" column="53" str=","/>
    <tok fileIndex="0" linenr="2292" column="9" str="&quot;   FLAWs, like lack of a sticky bit,&quot;"/>
    <tok fileIndex="0" linenr="2292" column="47" str=","/>
    <tok fileIndex="0" linenr="2293" column="9" str="&quot;   Serious DEFECTs, like lack of a guard digit, and&quot;"/>
    <tok fileIndex="0" linenr="2293" column="62" str=","/>
    <tok fileIndex="0" linenr="2294" column="9" str="&quot;   FAILUREs, like 2+2 == 5 .&quot;"/>
    <tok fileIndex="0" linenr="2294" column="39" str=","/>
    <tok fileIndex="0" linenr="2295" column="9" str="&quot;Failures may confound subsequent diagnoses.\n&quot;"/>
    <tok fileIndex="0" linenr="2295" column="56" str=","/>
    <tok fileIndex="0" linenr="2296" column="9" str="&quot;The diagnostic capabilities of this program go beyond an earlier&quot;"/>
    <tok fileIndex="0" linenr="2296" column="75" str=","/>
    <tok fileIndex="0" linenr="2297" column="9" str="&quot;program called `MACHAR&apos;, which can be found at the end of the&quot;"/>
    <tok fileIndex="0" linenr="2297" column="72" str=","/>
    <tok fileIndex="0" linenr="2298" column="9" str="&quot;book  `Software Manual for the Elementary Functions&apos; (1980) by&quot;"/>
    <tok fileIndex="0" linenr="2298" column="73" str=","/>
    <tok fileIndex="0" linenr="2299" column="9" str="&quot;W. J. Cody and W. Waite. Although both programs try to discover&quot;"/>
    <tok fileIndex="0" linenr="2299" column="74" str=","/>
    <tok fileIndex="0" linenr="2300" column="9" str="&quot;the Radix, Precision and range (over/underflow thresholds)&quot;"/>
    <tok fileIndex="0" linenr="2300" column="69" str=","/>
    <tok fileIndex="0" linenr="2301" column="9" str="&quot;of the arithmetic, this program tries to cope with a wider variety&quot;"/>
    <tok fileIndex="0" linenr="2301" column="77" str=","/>
    <tok fileIndex="0" linenr="2302" column="9" str="&quot;of pathologies, and to say how well the arithmetic is implemented.&quot;"/>
    <tok fileIndex="0" linenr="2302" column="77" str=","/>
    <tok fileIndex="0" linenr="2303" column="9" str="&quot;\nThe program is based upon a conventional radix representation for&quot;"/>
    <tok fileIndex="0" linenr="2303" column="78" str=","/>
    <tok fileIndex="0" linenr="2304" column="9" str="&quot;floating-point numbers, but also allows logarithmic encoding&quot;"/>
    <tok fileIndex="0" linenr="2304" column="71" str=","/>
    <tok fileIndex="0" linenr="2305" column="9" str="&quot;as used by certain early WANG machines.\n&quot;"/>
    <tok fileIndex="0" linenr="2305" column="52" str=","/>
    <tok fileIndex="0" linenr="2306" column="9" str="&quot;BASIC version of this program (C) 1983 by Prof. W. M. Kahan;&quot;"/>
    <tok fileIndex="0" linenr="2306" column="71" str=","/>
    <tok fileIndex="0" linenr="2307" column="9" str="&quot;see source comments for more history.&quot;"/>
    <tok fileIndex="0" linenr="2307" column="48" str=","/>
    <tok fileIndex="0" linenr="2308" column="9" str="0"/>
    <tok fileIndex="0" linenr="2308" column="10" str="}"/>
    <tok fileIndex="0" linenr="2308" column="11" str=";"/>
    <tok fileIndex="0" linenr="2310" column="5" str="msglist"/>
    <tok fileIndex="0" linenr="2310" column="13" str="("/>
    <tok fileIndex="0" linenr="2310" column="14" str="hist"/>
    <tok fileIndex="0" linenr="2310" column="18" str=")"/>
    <tok fileIndex="0" linenr="2310" column="19" str=";"/>
    <tok fileIndex="0" linenr="2311" column="1" str="}"/>
