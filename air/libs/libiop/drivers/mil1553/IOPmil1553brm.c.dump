    <tok fileIndex="0" linenr="1467" column="3" str="// /*This operation is reserved for BC mode*/"/>
    <tok fileIndex="0" linenr="1468" column="9" str="// if ( brm-&gt;mode != BRM_MODE_BC ){"/>
    <tok fileIndex="0" linenr="1469" column="11" str="// return AIR_INVALID_PARAM;"/>
    <tok fileIndex="0" linenr="1470" column="3" str="// }"/>
    <tok fileIndex="0" linenr="1472" column="9" str="// /* Check if we are bus controller */"/>
    <tok fileIndex="0" linenr="1473" column="9" str="// if ( ((READ_REG(&amp;brm-&gt;regs-&gt;oper)&gt;&gt;8) &amp; 3) != 0 ) {"/>
    <tok fileIndex="0" linenr="1474" column="13" str="// return AIR_INVALID_PARAM;"/>
    <tok fileIndex="0" linenr="1475" column="9" str="// }"/>
    <tok fileIndex="0" linenr="1477" column="9" str="// /* Already processing list? */"/>
    <tok fileIndex="0" linenr="1478" column="9" str="// if (is_executing(brm)) {"/>
    <tok fileIndex="0" linenr="1479" column="13" str="// return AIR_NOT_AVAILABLE;"/>
    <tok fileIndex="0" linenr="1480" column="9" str="// }"/>
    <tok fileIndex="0" linenr="1482" column="3" str="// /*No errors yet*/"/>
    <tok fileIndex="0" linenr="1483" column="3" str="// brm-&gt;bc_list_fail = 0;"/>
    <tok fileIndex="0" linenr="1485" column="3" str="// /*Copy pointer to user cmd list*/"/>
    <tok fileIndex="0" linenr="1486" column="9" str="// brm-&gt;cur_list = cmd_list;"/>
    <tok fileIndex="0" linenr="1488" column="3" str="// /* bc command list starts at list offset zero */"/>
    <tok fileIndex="0" linenr="1489" column="3" str="// brm-&gt;regs-&gt;dpoint = 0;"/>
    <tok fileIndex="0" linenr="1491" column="9" str="// i = 0;"/>
    <tok fileIndex="0" linenr="1493" column="3" str="// /* "/>
    <tok fileIndex="0" linenr="1494" column="4" str="// * Lets process command block while we don&apos;t finish the list, or while"/>
    <tok fileIndex="0" linenr="1495" column="4" str="// * the block count is less than the block count defined in the config"/>
    <tok fileIndex="0" linenr="1496" column="4" str="// */"/>
    <tok fileIndex="0" linenr="1497" column="9" str="// while (((cmd_list[i].ctrl &amp; BC_EOL) == 0) &amp;&amp; (i &lt; brm-&gt;bc_block_number-1)){"/>
    <tok fileIndex="0" linenr="1499" column="4" str="// /*diassemble user commands*/"/>
    <tok fileIndex="0" linenr="1500" column="13" str="// ctrl = (4&lt;&lt;12) | (((cmd_list[i].ctrl &amp; BC_BUSA) == BC_BUSA)&lt;&lt;9) | (((cmd_list[i].ctrl &amp; BC_RTRT) == BC_RTRT)&lt;&lt;8);"/>
    <tok fileIndex="0" linenr="1502" column="4" str="// /*If the user command is a RT to RT transmission*/"/>
    <tok fileIndex="0" linenr="1503" column="13" str="// if (cmd_list[i].ctrl &amp; BC_RTRT) {"/>
    <tok fileIndex="0" linenr="1504" column="5" str="// /* receive cw */"/>
    <tok fileIndex="0" linenr="1505" column="17" str="// cw1 = (cmd_list[i].rtaddr[0]&lt;&lt;11) | (0&lt;&lt;10) | (cmd_list[i].subaddr[0]&lt;&lt;5) | (cmd_list[i].wc &amp; 0x1f); "/>
    <tok fileIndex="0" linenr="1507" column="5" str="// /* transmit cw */"/>
    <tok fileIndex="0" linenr="1508" column="17" str="// cw2 = (cmd_list[i].rtaddr[1]&lt;&lt;11) | (1&lt;&lt;10) | (cmd_list[i].subaddr[1]&lt;&lt;5) | (cmd_list[i].wc &amp; 0x1f); "/>
    <tok fileIndex="0" linenr="1509" column="13" str="// }"/>
    <tok fileIndex="0" linenr="1511" column="4" str="// /*Other command than RT RT*/"/>
    <tok fileIndex="0" linenr="1512" column="13" str="// else {"/>
    <tok fileIndex="0" linenr="1514" column="5" str="// cw1 = (cmd_list[i].rtaddr[0]&lt;&lt;11) | (((cmd_list[i].ctrl&amp;BC_TR) == BC_TR)&lt;&lt;10) | (cmd_list[i].subaddr[0]&lt;&lt;5) | (cmd_list[i].wc &amp; 0x1f);"/>
    <tok fileIndex="0" linenr="1516" column="5" str="// /*Second command word is not used except for RT-RT*/"/>
    <tok fileIndex="0" linenr="1517" column="5" str="// cw2 = 0;"/>
    <tok fileIndex="0" linenr="1518" column="13" str="// }"/>
    <tok fileIndex="0" linenr="1521" column="13" str="// /* Set up command block */"/>
    <tok fileIndex="0" linenr="1522" column="13" str="// brm-&gt;bcmem-&gt;descs[i].ctrl   = ctrl;"/>
    <tok fileIndex="0" linenr="1523" column="13" str="// brm-&gt;bcmem-&gt;descs[i].cw1    = cw1;"/>
    <tok fileIndex="0" linenr="1524" column="13" str="// brm-&gt;bcmem-&gt;descs[i].cw2    = cw2;"/>
    <tok fileIndex="0" linenr="1525" column="13" str="// brm-&gt;bcmem-&gt;descs[i].dptr   = brm-&gt;bc_block_number*8+i*32;  /* data pointer: number of bc blocks*8 */"/>
    <tok fileIndex="0" linenr="1526" column="4" str="// brm-&gt;bcmem-&gt;descs[i].tsw[0] = 0;"/>
    <tok fileIndex="0" linenr="1527" column="4" str="// brm-&gt;bcmem-&gt;descs[i].tsw[1] = 0;"/>
    <tok fileIndex="0" linenr="1528" column="4" str="// brm-&gt;bcmem-&gt;descs[i].ba     = 0;"/>
    <tok fileIndex="0" linenr="1529" column="4" str="// brm-&gt;bcmem-&gt;descs[i].timer  = 0;"/>
    <tok fileIndex="0" linenr="1531" column="4" str="// /*Copy data*/"/>
    <tok fileIndex="0" linenr="1532" column="13" str="// memcpy((void *)&amp;brm-&gt;mem[brm-&gt;bcmem-&gt;descs[i].dptr], &amp;cmd_list[i].data[0], cmd_list[i].wc*2);"/>
    <tok fileIndex="0" linenr="1534" column="4" str="// /*Next command block*/"/>
    <tok fileIndex="0" linenr="1535" column="4" str="// i++;"/>
    <tok fileIndex="0" linenr="1536" column="9" str="// }"/>
    <tok fileIndex="0" linenr="1538" column="3" str="// /* end of comand block list */"/>
    <tok fileIndex="0" linenr="1539" column="9" str="// brm-&gt;bcmem-&gt;descs[i].ctrl = 0; "/>
